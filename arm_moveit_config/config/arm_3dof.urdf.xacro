<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm_3dof">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import arm_3dof urdf file -->
    <xacro:include filename="$(find arm_3dof_description)/urdf/robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="arm_3dof.ros2_control.xacro" />


    <xacro:arm_3dof_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
