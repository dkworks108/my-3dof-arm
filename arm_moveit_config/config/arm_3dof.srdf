<?xml version="1.0" encoding="UTF-8"?>
<robot name="arm_3dof">

    <!-- ARM PLANNING GROUP -->
    <group name="arm">
        <chain base_link="base_link" tip_link="tool_link"/>
    </group>

    <!-- GRIPPER PLANNING GROUP -->
    <group name="gripper">
        <joint name="left_finger_joint"/>
    </group>

    <!-- ARM STATES -->
    <group_state name="zero" group="arm">
        <joint name="joint1" value="0.0"/>
        <joint name="joint2" value="0.0"/>
        <joint name="joint3" value="0.0"/>
    </group_state>

    <group_state name="home" group="arm">
        <joint name="joint1" value="0.0"/>
        <joint name="joint2" value="0.2217"/>
        <joint name="joint3" value="1.2842"/>
    </group_state>

    <!-- GRIPPER STATES -->
    <group_state name="open" group="gripper">
        <joint name="left_finger_joint" value="0.035"/>
    </group_state>

    <group_state name="close" group="gripper">
        <joint name="left_finger_joint" value="0.0"/>
    </group_state>

    <!-- END EFFECTOR -->
    <end_effector
        name="eef"
        parent_link="gripper_base_link"
        parent_group="arm"
        group="gripper"/>

    <!-- DISABLE COLLISIONS -->
    <disable_collisions link1="base_link" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="left_finger_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link2" reason="Never"/>
    <disable_collisions link1="base_link" link2="link3" reason="Never"/>
    <disable_collisions link1="base_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="left_finger_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="link1" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="link2" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger_link" link2="link1" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="link2" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="link3" reason="Never"/>
    <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link3" reason="Never"/>
    <disable_collisions link1="link1" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="right_finger_link" reason="Never"/>
    <disable_collisions link1="link3" link2="right_finger_link" reason="Never"/>

</robot>
