<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm_3dof">

  <xacro:arg name="gazebo_system" default="ignition"/>
  <xacro:arg name="controllers_yaml" default="config/controllers.yaml"/>

  <!-- ==================== Materials for RViz ==================== -->
  <material name="dark_grey">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.8 0.8 0.85 1.0"/>
  </material>
  <material name="industrial_orange">
    <color rgba="0.95 0.45 0.1 1.0"/>
  </material>
  <material name="accent_blue">
    <color rgba="0.15 0.35 0.85 1.0"/>
  </material>
  <material name="gripper_body">
    <color rgba="0.2 0.2 0.22 1.0"/>
  </material>
  <material name="finger_pad">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ==================== World Anchor Link ==================== -->
  <!-- Anchoring base_link to world prevents the arm from tipping over under gravity in simulation -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Base Link ==================== -->
  <!-- Stationary foundation pedestal -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.04"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.0093" ixy="0.0" ixz="0.0" iyy="0.0093" iyz="0.0" izz="0.018"/>
    </inertial>
  </link>

  <!-- ==================== Joint 1: Base Turret Rotation (Z-Axis) ==================== -->
  <!-- Left/right yaw rotation around the vertical Z-axis -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="40.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Link 1: Rotating Turret and Shoulder Support Column -->
  <link name="link1">
    <visual>
      <!-- Lower rotating platform -->
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.03"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual>
      <!-- Shoulder bracket column -->
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.17"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <visual>
      <!-- Shoulder pivot joint hub -->
      <origin xyz="0 0 0.185" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.20"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.0048" ixy="0.0" ixz="0.0" iyy="0.0048" iyz="0.0" izz="0.0022"/>
    </inertial>
  </link>

  <!-- ==================== Joint 2: Shoulder Pitch (Y-Axis) ==================== -->
  <!-- Raises and lowers the upper arm. Operates in the X-Z vertical plane -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.185" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.745" upper="1.745" effort="40.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Link 2: Articulated Upper Arm -->
  <link name="link2">
    <visual>
      <!-- Upper arm body (length 0.30m) -->
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.30"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <visual>
      <!-- Elbow pivot joint hub -->
      <origin xyz="0 0 0.30" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.07"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.00617" ixy="0.0" ixz="0.0" iyy="0.00617" iyz="0.0" izz="0.00033"/>
    </inertial>
  </link>

  <!-- ==================== Joint 3: Elbow Pitch (Y-Axis) ==================== -->
  <!-- Bends and extends the forearm. Axis is PARALLEL to Joint 2 (in the exact same mechanical plane) -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="2.094" effort="30.0" velocity="2.0"/>
    <dynamics damping="0.3" friction="0.08"/>
  </joint>

  <!-- Link 3: Articulated Forearm -->
  <link name="link3">
    <visual>
      <!-- Forearm structural beam (length 0.22m) -->
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.22"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <visual>
      <!-- Wrist tool mounting flange -->
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.015"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00208" ixy="0.0" ixz="0.0" iyy="0.00208" iyz="0.0" izz="0.00013"/>
    </inertial>
  </link>

  <!-- ==================== Wrist Mount Joint ==================== -->
  <joint name="tool_joint" type="fixed">
    <parent link="link3"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.2275" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Two-Finger Parallel Gripper ==================== -->
  <!-- Gripper Base Chassis -->
  <link name="gripper_base_link">
    <visual>
      <!-- Actuator main housing -->
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
      <material name="gripper_body"/>
    </visual>
    <visual>
      <!-- Linear guide rail bar -->
      <origin xyz="0 0 0.038" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.045"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00020" ixy="0.0" ixz="0.0" iyy="0.00010" iyz="0.0" izz="0.00022"/>
    </inertial>
  </link>

  <!-- Left Finger Joint (Prismatic) -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.015 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.035" effort="30.0" velocity="0.15"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Left Finger Link -->
  <link name="left_finger_link">
    <visual>
      <!-- Finger arm -->
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.01 0.05"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual>
      <!-- High friction gripping pad (inward facing towards center) -->
      <origin xyz="0 -0.004 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.004 0.03"/>
      </geometry>
      <material name="finger_pad"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.012 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000011" ixy="0.0" ixz="0.0" iyy="0.000013" iyz="0.0" izz="0.0000032"/>
    </inertial>
  </link>

  <!-- Right Finger Joint (Prismatic with Symmetrical Mimic Motion) -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.015 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.035" upper="0.0" effort="30.0" velocity="0.15"/>
    <mimic joint="left_finger_joint" multiplier="-1.0" offset="0.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Right Finger Link -->
  <link name="right_finger_link">
    <visual>
      <!-- Finger arm -->
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.01 0.05"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual>
      <!-- High friction gripping pad (inward facing towards center) -->
      <origin xyz="0 0.004 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.004 0.03"/>
      </geometry>
      <material name="finger_pad"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.012 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000011" ixy="0.0" ixz="0.0" iyy="0.000013" iyz="0.0" izz="0.0000032"/>
    </inertial>
  </link>

  <!-- Tool Center Point (TCP) Link for Grasping / Forward Kinematics Tracking -->
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="finger_pad"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.0000001" ixy="0.0" ixz="0.0" iyy="0.0000001" iyz="0.0" izz="0.0000001"/>
    </inertial>
  </link>

  <!-- ==================== Gazebo Physics & Friction Properties ==================== -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>

  <gazebo reference="link1">
    <material>Gazebo/Blue</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="link2">
    <material>Gazebo/Orange</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="link3">
    <material>Gazebo/Blue</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="gripper_base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <!-- High-friction contact surfaces for realistic physics grasping -->
  <gazebo reference="left_finger_link">
    <material>Gazebo/Grey</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="right_finger_link">
    <material>Gazebo/Grey</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <!-- ==================== ros2_control Hardware Interface ==================== -->
  <ros2_control name="Arm3dofHardware" type="system">
    <hardware>
      <xacro:if value="${'$(arg gazebo_system)' == 'ignition'}">
        <plugin>ign_ros2_control/IgnitionSystem</plugin>
      </xacro:if>
      <xacro:unless value="${'$(arg gazebo_system)' == 'ignition'}">
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </xacro:unless>
    </hardware>

    <!-- Arm Revolute Joints -->
    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-1.745</param>
        <param name="max">1.745</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-2.094</param>
        <param name="max">2.094</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Gripper Prismatic Joints for Actuation -->
    <joint name="left_finger_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.035</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position">
        <param name="min">-0.035</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ==================== Gazebo ros2_control Plugin ==================== -->
  <xacro:if value="${'$(arg gazebo_system)' == 'ignition'}">
    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(arg controllers_yaml)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
  <xacro:unless value="${'$(arg gazebo_system)' == 'ignition'}">
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(arg controllers_yaml)</parameters>
      </plugin>
    </gazebo>
  </xacro:unless>

</robot>
